rules_version = '2';

// Only the root Super Admin login (vishalsaxen@gmail.com, signed in with its Firebase password)
// may read or write anything. Keep the email the same as SUPER_ADMIN_EMAIL in index.html.
// Create that user once in Firebase console > Authentication > Users > Add user, and turn off
// sign-up (Authentication > Settings > User actions) so nobody else can register.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "password"
        && request.auth.token.email == "vishalsaxen@gmail.com";
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
