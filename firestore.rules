rules_version = '2';

// Only the Super Admin (mobile 9665121212, logged in with an SMS OTP) may read or write anything.
// Keep this number the same as SUPER_ADMIN_PHONE in index.html, then publish these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.phone_number == "+919665121212";
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
